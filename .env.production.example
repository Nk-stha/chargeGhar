# ============================================
# ChargeGhar Dashboard — Production Environment Template
# ============================================
# Copy this to .env on your VPS and fill in the values
# DO NOT commit the actual .env file to git
# ============================================

# ----- Application -----
NODE_ENV=production
BASE_URL=https://main.chargeghar.com/api
API_BASE_URL=https://main.chargeghar.com/api
NEXT_PUBLIC_API_BASE_URL=https://main.chargeghar.com/api

# ----- Docker Image -----
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# ----- Nginx -----
# Port exposed on the host machine
NGINX_PORT=3500
